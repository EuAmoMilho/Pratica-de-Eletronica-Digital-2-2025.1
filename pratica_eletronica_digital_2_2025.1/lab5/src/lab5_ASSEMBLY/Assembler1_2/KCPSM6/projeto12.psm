;projeto_1_sim_2

CONSTANT chavesd, 00
CONSTANT chavesp, 01
CONSTANT leds, 04



function:	INPUT s1, chavesp
    		INPUT s0, chavesd
    		
    		COMPARE s1, 03
    		JUMP Z, pattern3

    		COMPARE s1, 02
    		JUMP Z, pattern2

    		COMPARE s1, 01
    		JUMP Z, pattern1

    		JUMP pattern0

pattern3:	LOAD s3, 0D
            COMPARE s4, s3
            JUMP Z, direction
            LOAD s4, s3
            LOAD s5, s4
            JUMP direction

pattern2:	LOAD s3, 0F
            COMPARE s4, s3
            JUMP Z, direction
            LOAD s4, s3
            LOAD s5, s4
		    JUMP direction
		
pattern1:	LOAD s3, 03
            COMPARE s4, s3
            JUMP Z, direction
            LOAD s4, s3
            LOAD s5, s4
            JUMP direction		

pattern0:	LOAD s3, 01
            COMPARE s4, s3
            JUMP Z, direction
            LOAD s4, s3
            LOAD s5, s4

direction:	COMPARE s0, 01
    		JUMP Z, toleft
    		JUMP toright

toleft:		RL s5
		    JUMP done

toright:    RR s5
		    JUMP done

done:		OUTPUT s5, leds
		    JUMP function
